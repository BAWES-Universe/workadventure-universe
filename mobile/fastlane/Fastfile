# frozen_string_literal: true

# Fastlane automation lanes for building, testing, and publishing the signed
# BAWES Universe Android App Bundle (AAB) to Google Play Store internal track.
platform :android do
  desc "Build a signed release AAB"
  lane :build do
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV.fetch("KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("STORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("KEY_PASSWORD"),
      },
    )
  end

  desc "Deploy to Play Store internal track"
  lane :deploy do
    build
    upload_to_play_store(track: "internal")
  end

  desc "Run Android tests"
  lane :test do
    gradle(project_dir: "android", task: "test")
  end
end
