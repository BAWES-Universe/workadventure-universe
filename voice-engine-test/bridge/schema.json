{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universe.local/voice-bridge/v1/schema.json",
  "title": "Voice bridge v1 (bot server <-> voice engine)",
  "description": "One JSON object per WebSocket text frame. `type` is the discriminator. Unknown fields are ignored. Times are epoch milliseconds from the sender's clock.",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ts": { "type": "number" },
    "lane": { "type": "integer", "minimum": 0, "description": "Index of one human audio path inside a session. One lane per connected human." },
    "mode": { "enum": ["off", "listen_only", "talk", "type_and_listen", "speak_and_read"] },
    "participant": {
      "type": "object", "required": ["participantId", "lane"],
      "properties": { "participantId": { "$ref": "#/$defs/id" }, "lane": { "$ref": "#/$defs/lane" } }
    },
    "base": {
      "type": "object", "required": ["type", "sessionId"],
      "properties": { "type": { "type": "string" }, "sessionId": { "$ref": "#/$defs/id" }, "ts": { "$ref": "#/$defs/ts" } }
    }
  },
  "oneOf": [
    { "title": "engine -> brain: first message on a connection",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "bubbleId", "participants", "mode", "engine"],
        "properties": {
          "type": { "const": "session.start" },
          "bubbleId": { "$ref": "#/$defs/id" },
          "participants": { "type": "array", "items": { "$ref": "#/$defs/participant" } },
          "mode": { "$ref": "#/$defs/mode" },
          "engine": { "type": "object", "required": ["id", "kind", "turnEnd"],
            "properties": { "id": { "type": "string" }, "kind": { "enum": ["pipecat", "ts"] }, "turnEnd": { "enum": ["local", "provider"] } } }
        } }] },
    { "title": "engine -> brain",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "participantId", "lane"],
        "properties": { "type": { "const": "participant.join" }, "participantId": { "$ref": "#/$defs/id" }, "lane": { "$ref": "#/$defs/lane" }, "rejoin": { "type": "boolean" } } }] },
    { "title": "engine -> brain",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "participantId", "lane", "reason"],
        "properties": { "type": { "const": "participant.leave" }, "participantId": { "$ref": "#/$defs/id" }, "lane": { "$ref": "#/$defs/lane" }, "reason": { "enum": ["closed", "failed", "left"] } } }] },
    { "title": "brain -> engine",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "mode"],
        "properties": { "type": { "const": "mode.set" }, "mode": { "$ref": "#/$defs/mode" },
          "participantId": { "$ref": "#/$defs/id", "description": "Omit to set every lane in the session." } } }] },
    { "title": "engine -> brain: VAD heard a person start talking",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "lane", "participantId", "whileBotSpeaking"],
        "properties": { "type": { "const": "user.speech_started" }, "lane": { "$ref": "#/$defs/lane" }, "participantId": { "$ref": "#/$defs/id" },
          "whileBotSpeaking": { "type": "boolean" }, "turnId": { "type": "string" } } }] },
    { "title": "engine -> brain: a person's turn (interim while partial=true, final when partial=false)",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "lane", "participantId", "turnId", "text", "partial", "droppedAudioMs"],
        "properties": { "type": { "const": "user.turn" }, "lane": { "$ref": "#/$defs/lane" }, "participantId": { "$ref": "#/$defs/id" },
          "turnId": { "type": "string" }, "text": { "type": "string" },
          "partial": { "type": "boolean", "description": "true = interim text, a later user.turn with the same turnId replaces it. false = final for this turn." },
          "droppedAudioMs": { "type": "number", "minimum": 0, "description": "Audio the engine knows it did not receive (network loss, gaps) during this turn." },
          "incomplete": { "type": "boolean", "description": "true on a final turn when droppedAudioMs > 0: words may be missing." },
          "speechMs": { "type": "number" }, "endReason": { "enum": ["smart_turn", "provider_eot", "stop_secs_timeout", "mode_change", "voice_stop", "lane_closed"] },
          "emotion": { "type": "object", "required": ["label", "confidence", "source"], "description": "Optional. Set by an optional engine step that looks at the turn's raw audio. Absent when the step is off.",
            "properties": { "label": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "type": "string", "description": "which step produced it; the test stub says 'stub'" } } },
          "speechStartedAt": { "$ref": "#/$defs/ts" }, "turnEndedAt": { "$ref": "#/$defs/ts", "description": "When the engine decided the turn was over." } } }] },
    { "title": "chat path -> brain (never sent by an engine): a typed message in a voice session",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "participantId", "text"],
        "properties": { "type": { "const": "user.text" }, "participantId": { "$ref": "#/$defs/id" }, "text": { "type": "string" }, "messageId": { "type": "string" } } }] },
    { "title": "brain -> engine: speak this. Only committed text may be spoken.",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "segmentId", "text", "committed"],
        "properties": { "type": { "const": "bot.say" }, "segmentId": { "$ref": "#/$defs/id" }, "text": { "type": "string", "minLength": 1 },
          "committed": { "const": true }, "lang": { "type": "string" } } }] },
    { "title": "brain -> engine: this segment was withdrawn. Unplayed audio is dropped; played audio cannot be unplayed.",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "segmentId"],
        "properties": { "type": { "const": "bot.retract" }, "segmentId": { "$ref": "#/$defs/id" } } }] },
    { "title": "engine -> brain: how much audio was actually sent to listeners. Never says which words were heard.",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "segmentId", "playedMs", "finished", "interrupted"],
        "properties": { "type": { "const": "playback.progress" }, "segmentId": { "$ref": "#/$defs/id" },
          "playedMs": { "type": "number", "minimum": 0 }, "totalMs": { "type": "number", "minimum": 0 },
          "finished": { "type": "boolean" }, "interrupted": { "type": "boolean" },
          "reason": { "enum": ["completed", "barge_in", "voice_stop", "retract", "mode", "lane_loss", "rejected"] } } }] },
    { "title": "brain -> engine: stop listening and speaking for this session. The session stays open for text.",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "reason"],
        "properties": { "type": { "const": "voice.stop" }, "reason": { "enum": ["allowance_ended", "other"] } } }] },
    { "title": "engine -> brain: periodic (1 s) and on change",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "engineId", "voice", "mode", "lanes"],
        "properties": { "type": { "const": "engine.status" }, "engineId": { "type": "string" }, "voice": { "enum": ["active", "stopped"] }, "mode": { "$ref": "#/$defs/mode" },
          "lanes": { "type": "array", "items": { "type": "object", "required": ["participantId", "lane", "healthy", "mode"],
            "properties": { "participantId": { "type": "string" }, "lane": { "type": "integer" }, "healthy": { "type": "boolean" }, "mode": { "$ref": "#/$defs/mode" } } } },
          "counters": { "type": "object", "additionalProperties": { "type": "number" } } } }] },
    { "title": "brain -> engine",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type"], "properties": { "type": { "const": "session.end" } } }] },
    { "title": "either direction: protocol or runtime error report",
      "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object",
        "required": ["type", "code", "message"], "properties": { "type": { "const": "error" }, "code": { "type": "string" }, "message": { "type": "string" } } }] }
  ]
}
